/** BACKEND PARA INSCRIPCIONES UVG. Se instala en Apps Script vinculado a una hoja privada. */
const SHEET_NAME='Inscripciones';
const HEADERS=['Fecha de registro','ID solicitud','Nombre','Correo','Teléfono','Colegio','Cargo','Fecha preferida','Disponibilidad','Restricciones alimentarias','Aceptación','Estado'];
const FECHAS=['2026-11-16','2026-11-17','2026-11-18'];
function inicializar(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error('Vincule el script a una hoja de Google Sheets.');let sh=ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0){sh.appendRow(HEADERS);sh.setFrozenRows(1);sh.getRange('A1:L1').setFontWeight('bold').setBackground('#008D36').setFontColor('#FFFFFF');}Logger.log(ss.getUrl());}
function doGet(){return HtmlService.createHtmlOutput('<p>Servicio de inscripción UVG activo. Use el formulario de la página oficial.</p>');}
function doPost(e){const p=e&&e.parameter?e.parameter:{};const id=String(p.requestId||'').slice(0,100);let result;try{result=registrar_(p,id);}catch(err){result={ok:false,error:'No se pudo completar el registro. Contacte al organizador.',requestId:id};console.error(err);}return HtmlService.createHtmlOutput('<!doctype html><html><body><script>window.parent.postMessage('+JSON.stringify({source:'uvg-registro',...result}).replace(/</g,'\\u003c')+',"*");</script><p>Respuesta procesada. Puede volver a la página.</p></body></html>');}
function registrar_(p,id){const clean=(v,max)=>String(v||'').trim().slice(0,max);const nombre=clean(p.nombre,120),correo=clean(p.correo,160).toLowerCase(),telefono=clean(p.telefono,20),colegio=clean(p.colegio,160),cargo=clean(p.cargo,120),fecha=clean(p.fecha,20),disponibilidad=clean(p.disponibilidad,70),alimentacion=clean(p.alimentacion,350),aceptacion=clean(p.aceptacion,5);if(p.website)return {ok:true,requestId:id};
 if(!id||nombre.length<5||!/^\S+@\S+\.\S+$/.test(correo)||!/[0-9]{8}/.test(telefono.replace(/\D/g,''))||colegio.length<3||cargo.length<3||!FECHAS.includes(fecha)||!['Las tres fechas','Otra fecha previa consulta','Solo fecha preferida'].includes(disponibilidad)||aceptacion!=='SI')return {ok:false,error:'Revise los campos obligatorios.',requestId:id};
 // Cierre basado en hora oficial de Guatemala.
 const today=Utilities.formatDate(new Date(),'America/Guatemala','yyyy-MM-dd');if(today>'2026-11-10')return {ok:false,error:'El plazo de inscripción finalizó el 10 de noviembre de 2026.',requestId:id};
 const lock=LockService.getScriptLock();if(!lock.tryLock(10000))return {ok:false,error:'El sistema está ocupado. Intente nuevamente.',requestId:id};try{const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);if(!sh)throw Error('Ejecute inicializar() primero.');const last=sh.getLastRow();if(last>1){const rows=sh.getRange(2,2,last-1,3).getValues();for(const row of rows){if(String(row[0])===id||String(row[2]).toLowerCase()===correo)return {ok:true,requestId:id};}}
 const safe=v=>/^[=+\-@]/.test(v)?"'"+v:v;sh.appendRow([new Date(),id,safe(nombre),safe(correo),safe(telefono),safe(colegio),safe(cargo),fecha,safe(disponibilidad),safe(alimentacion),'Sí','Pendiente de revisión']);return {ok:true,requestId:id};}finally{lock.releaseLock();}}
